# Copie este arquivo para ".env" e preencha os valores

# Porta em que o servidor vai rodar (no Render, ele define isso sozinho — pode deixar)
PORT=3000

# Chave secreta usada para assinar os tokens de login (pode ser qualquer texto longo e aleatório)
JWT_SECRET=troque-isto-por-um-texto-secreto-bem-grande-e-aleatorio

# Chave da API da Anthropic, usada para gerar as sugestões de melhoria das aulas
# Crie a sua em https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Credenciais do banco de dados no Turso (gratuito)
# Crie sua conta e um banco em https://turso.tech, depois copie a URL e o token daqui:
# turso db show SEU-BANCO --url
# turso db tokens create SEU-BANCO
TURSO_DATABASE_URL=libsql://seu-banco-sua-org.turso.io
TURSO_AUTH_TOKEN=coloque-o-token-aqui
